# Variáveis do Happy Hoops (no Render: aba Environment do Web Service)

# OBRIGATÓRIAS em produção
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require   # Neon: Connect → connection string (pooled)
ADMIN_PASSWORD=troque-esta-senha                    # senha do /admin

# Recomendadas
SESSION_SECRET=um-texto-longo-e-aleatorio           # (o render.yaml gera sozinho)
TRUST_PROXY=1                                       # atrás do Render: IP real no limite de tentativas de login

# Opcionais
# PORT=3000               (o Render define sozinho)
# DATABASE_SSL=1|0        (padrão: automático — SSL para hosts externos como o Neon)
# DB_PATH=data/happy-hoops.db   (só se NÃO usar DATABASE_URL: SQLite local para desenvolvimento)
# SEED_DEMO=1             (cria 8 atletas de exemplo se o banco estiver vazio — deixe desligado em produção)
